# LLM provider: openai_compatible | openrouter | groq | anthropic
#   openai_compatible → set LLM_BASE_URL: DeepSeek https://api.deepseek.com,
#     Qwen https://dashscope.aliyuncs.com/compatible-mode/v1, Ollama http://localhost:11434/v1,
#     empty = OpenAI
#   openrouter → URL filled in automatically; LLM_MODEL like deepseek/deepseek-chat, qwen/qwen-2.5-72b-instruct
#   groq       → URL filled in automatically; LLM_MODEL like llama-3.3-70b-versatile
#   anthropic  → LLM_MODEL like claude-sonnet-5-5
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
LLM_CONTEXT_TOKENS=32000
# function_calling (default) | json_mode | json_schema — switch if a model rejects tool calls
LLM_STRUCTURED_METHOD=function_calling

# Embeddings — openai_compatible | huggingface
# (OpenRouter and Groq have no embeddings API: point this at DashScope, OpenAI, Ollama, …)
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# App
DATA_DIR=./data
MAX_UPLOAD_MB=20
OUTPUT_LANGUAGE=auto
# Vision model for charts/diagrams/screenshots — empty VISION_MODEL disables image analysis
# (text model like deepseek-chat can't see images; use e.g. qwen-vl-max, gpt-4o-mini, claude-sonnet-5-5,
#  OpenRouter qwen/qwen2.5-vl-72b-instruct, Groq meta-llama/llama-4-scout-17b-16e-instruct)
# VISION_PROVIDER/BASE_URL/API_KEY empty = reuse the LLM_* connection
VISION_MODEL=
VISION_PROVIDER=
VISION_BASE_URL=
VISION_API_KEY=
MAX_FIGURES_PER_DOC=40

CORS_ORIGINS=["http://localhost:5173"]
