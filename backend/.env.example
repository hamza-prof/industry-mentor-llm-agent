# LLM — any OpenAI-compatible endpoint (DeepSeek, Qwen/DashScope, OpenAI, Ollama) or anthropic
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
LLM_CONTEXT_TOKENS=32000

# Embeddings — openai_compatible | huggingface
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# App
DATA_DIR=./data
MAX_UPLOAD_MB=20
OUTPUT_LANGUAGE=auto
# Vision model for charts/diagrams/screenshots — empty VISION_MODEL disables image analysis
# (text model like deepseek-chat can't see images; use e.g. qwen-vl-max, gpt-4o-mini, claude-sonnet-5-5)
VISION_MODEL=
VISION_PROVIDER=
VISION_BASE_URL=
VISION_API_KEY=
MAX_FIGURES_PER_DOC=40

CORS_ORIGINS=["http://localhost:5173"]
